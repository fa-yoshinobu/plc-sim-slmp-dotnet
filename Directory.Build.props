<Project>
  <!-- 全プロジェクト共通の製品情報（バージョン情報ウィンドウ・exe のプロパティに表示） -->
  <PropertyGroup>
    <Product>PLC Sim (SLMP)</Product>
    <Version>0.1.3</Version>
    <Company>FA Labo</Company>
    <Authors>FA Labo(fa_yoshinobu)</Authors>
    <Copyright>Copyright (c) 2026 FA Labo</Copyright>
    <BundledRuntimeVersion>10.0.14</BundledRuntimeVersion>
    <RuntimeFrameworkVersion Condition="'$(MSBuildProjectName)' == 'PlcSim.Slmp.Gui' Or '$(MSBuildProjectName)' == 'PlcSim.Slmp.Host'">$(BundledRuntimeVersion)</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
