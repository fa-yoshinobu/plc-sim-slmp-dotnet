<UserControl
    x:Class="PlcSim.Slmp.Gui.Views.MemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcSim.Slmp.Gui.ViewModels"
    xmlns:controls="clr-namespace:PlcSim.Slmp.Gui.Controls"
    mc:Ignorable="d"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:MemoryViewModel}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="AreaView" Source="{Binding FilteredAreas}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 領域一覧の項目 -->
        <Style x:Key="AreaItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Rail" Width="3" HorizontalAlignment="Left" Margin="0,4" CornerRadius="2"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- グリッドのセル -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Cell_MouseLeftButtonDown" />
            <EventSetter Event="MouseLeftButtonUp" Handler="Cell_MouseLeftButtonUp" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBit}" Value="True" />
                        <Condition Binding="{Binding IsOn}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsRecent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Dads.Highlight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBit}" Value="True" />
                        <Condition Binding="{Binding IsOn}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBit}" Value="True" />
                        <Condition Binding="{Binding IsOn}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ToggleButton Style="{StaticResource OutlineToggle}" Content="読出し専用" IsChecked="{Binding ReadOnlyMode}" Margin="0,0,6,0"  />
                <Button Style="{StaticResource OutlineButton}" Command="{Binding ExportCsvCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="CSV 出力" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="メモリビューア" Style="{StaticResource PageTitle}" />
                <TextBlock Text="MELSEC の全領域を実機と同じ点数・番地・表記で表示。左で領域を選び、番地へ移動。値はダブルクリックで変更（ビットは反転）。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 領域一覧 -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="8">
                <DockPanel>
                    <ui:TextBox DockPanel.Dock="Top" PlaceholderText="領域を絞込み（例: LT, U0）" Text="{Binding AreaFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Source={StaticResource AreaView}}" SelectedItem="{Binding SelectedArea}"
                             ItemContainerStyle="{StaticResource AreaItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="6,10,0,3" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MemoryArea}">
                                <Grid ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding PointsText}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 表示 -->
            <DockPanel Grid.Column="2">
                <!-- ツールバー -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="10,8">
                    <WrapPanel>
                        <TextBlock Text="番地" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ui:TextBox Width="140" Text="{Binding JumpText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                    KeyDown="JumpBox_KeyDown" PlaceholderText="D100 / U0\G10" Margin="0,0,6,0" />
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding JumpCommand}" Margin="0,0,14,0" Content="移動" />
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="10進" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=dec}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="16進" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=hex}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="符号付" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=s16}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="32bit" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=u32}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="Float" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=f32}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="fmt" Content="ASCII" IsChecked="{Binding Format, Converter={StaticResource EqualsToBool}, ConverterParameter=asc}" />
                            </StackPanel>
                        </Border>
                        <CheckBox Content="値のある番地だけ" IsChecked="{Binding NonZeroOnly}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowUnitSelector, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ユニット" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding SelectedUnit}" MinWidth="96" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowCpuSelector, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="CPU" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding CpuChoices}" SelectedItem="{Binding SelectedCpu}" MinWidth="110" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowNetworkSelector, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ネットワーク" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding NetworkChoices}" SelectedItem="{Binding SelectedNetwork}" MinWidth="96" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- 範囲 -->
                <StackPanel DockPanel.Dock="Top" Margin="2,10,2,6">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding SelectedArea.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                            <Run Text="  " />
                            <Run Text="{Binding SelectedArea.Description, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                            <Run Text="  " />
                            <Run Text="{Binding SelectedArea.RangeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ViewRangeText}" Style="{StaticResource FieldLabel}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <controls:RangeBar Height="12" Margin="0,6,0,0" ThumbStart="{Binding ThumbStart}" ThumbSize="{Binding ThumbSize}" Marks="{Binding Marks}"
                                       ToolTip="青: 表示中の位置　橙: 書込みがあった位置" />
                </StackPanel>

                <!-- 下部情報 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
                    <TextBlock Text="{Binding SelectedInfo}" Style="{StaticResource FieldLabel}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <!-- グリッド -->
                <Border Style="{StaticResource Panel}" Padding="6,6,2,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 見出し -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ElementName=Root, Path=AddressColumnWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="番地" Style="{StaticResource FieldLabel}" Margin="4,0" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Headers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0,0,5,0" FontFamily="{StaticResource MonoFont}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />

                        <!-- 行 -->
                        <Grid Grid.Row="1" x:Name="RowsHost" Background="Transparent" ClipToBounds="True"
                              SizeChanged="RowsHost_SizeChanged" PreviewMouseWheel="RowsHost_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MemoryRow}">
                                        <Grid Height="32">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ElementName=Root, Path=AddressColumnWidth}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="14" VerticalAlignment="Center" Margin="4,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasValue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:MemoryCell}">
                                                        <Border Style="{StaticResource CellBorder}" Tag="{Binding}">
                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource CellText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 値の入力 -->
                            <Popup x:Name="EditPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                <Border Style="{StaticResource Panel}" Padding="8" Background="{DynamicResource ApplicationBackgroundBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="EditTitle" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBox x:Name="EditBox" Width="160" FontFamily="{StaticResource MonoFont}" KeyDown="EditBox_KeyDown" />
                                            <Button Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="EditOk_Click" Content="書込み" />
                                        </StackPanel>
                                        <TextBlock x:Name="EditError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="260" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Vertical" Minimum="0"
                                   Maximum="{Binding MaxTopRow}" Value="{Binding TopRow}" ViewportSize="{Binding VisibleRows}"
                                   SmallChange="1" LargeChange="{Binding VisibleRows}" />
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 直近アクセス -->
            <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="直近アクセス" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="rk" Content="全て" IsChecked="{Binding RecentKind, Converter={StaticResource EqualsToBool}, ConverterParameter=all}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="rk" Content="書込" IsChecked="{Binding RecentKind, Converter={StaticResource EqualsToBool}, ConverterParameter=W}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="rk" Content="読出" IsChecked="{Binding RecentKind, Converter={StaticResource EqualsToBool}, ConverterParameter=R}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="クリックでその番地へ移動。同じ範囲・同じアクセス元の連続アクセスは回数にまとめます。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding Recent}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Recent_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AreaItem}">
                                <Setter Property="Padding" Value="6,5" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KindText}" Value="書込">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding KindText}" FontSize="14" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Display}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" HorizontalAlignment="Right">
                                        <Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Times, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Source}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
