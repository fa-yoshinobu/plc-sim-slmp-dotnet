<UserControl
    x:Class="PlcSim.Slmp.Gui.Views.DeviceRangeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcSim.Slmp.Gui.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:DeviceRangeViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource TextButton}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,6,0" Content="既定に戻す" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0,0,6,0" IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="適用" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="設定ファイルに保存" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="デバイス範囲" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="実機のパラメータ（デバイス点数）に合わせて使用範囲の上限を設定します。適用するとメモリ内容を引き継いで仮想 PLC を作り直し、SD の点数レジスタも更新します。" />
            </StackPanel>
        </DockPanel>
        <!-- ユニット・ネットワークの登録（番号は任意、最大 4 個） -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UnitCountText}" Style="{StaticResource FieldLabel}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="バッファメモリ（装着ユニット Un\G）" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                    <TextBlock Text="U の後ろの番号（16 進、先頭入出力番号の上位桁）。未登録のユニットへの U\G・拡張ユニット読書きはエラー応答。U3E0〜U3E3 は CPU バッファメモリのため登録不要。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Units}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="12,2,4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource TextButton}" Content="削除" Margin="8,0,0,0" MinHeight="28"
                                                Command="{Binding DataContext.RemoveUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="U" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="96" Text="{Binding NewUnit, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <Button Style="{StaticResource OutlineButton}" Content="追加" Command="{Binding AddUnitCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding NetworkCountText}" Style="{StaticResource FieldLabel}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="リンクダイレクト（ネットワーク Jn\）" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                    <TextBlock Text="J の後ろのネットワーク番号（10 進、1〜239）。デバイスは X / Y / B / SB / W / SW。未登録のネットワークへのアクセスはエラー応答。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Networks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="12,2,4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource TextButton}" Content="削除" Margin="8,0,0,0" MinHeight="28"
                                                Command="{Binding DataContext.RemoveNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="J" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="96" Text="{Binding NewNetwork, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <Button Style="{StaticResource OutlineButton}" Content="追加" Command="{Binding AddNetworkCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="2,0,2,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding ProfileText}" FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="4">
            <ListView ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubtleListViewItem}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファミリ" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <TextBlock Text="{Binding Family}" Style="{StaticResource Mono}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="デバイス" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <TextBlock Text="{Binding Devices}" Style="{StaticResource Mono}" FontSize="14" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="名称" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="既定点数" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <TextBlock Text="{Binding DefaultText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="設定点数" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border BorderThickness="1" CornerRadius="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBox Text="{Binding PointsText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Width="120" TextAlignment="Right" />
                                        </Border>
                                        <TextBlock Text="変更" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="使用範囲" Width="230">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <StackPanel><TextBlock Text="{Binding RangeText}" Style="{StaticResource Mono}" FontSize="14" /><TextBlock Text="{Binding SharedNote}" Style="{StaticResource FieldLabel}" Visibility="{Binding SharedNote, Converter={StaticResource NotEmptyToVisibility}}" /></StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="点数レジスタ" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRangeRow}">
                                    <TextBlock Text="{Binding SdText}" Style="{StaticResource Mono}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Message}" Margin="2,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
