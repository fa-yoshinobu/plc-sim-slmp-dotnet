<ui:FluentWindow
    x:Class="PlcSim.Slmp.Gui.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="バージョン情報"
    Icon="pack://application:,,,/Assets/PlcSim.ico"
    Width="800" Height="680" MinWidth="680" MinHeight="480"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    Background="{DynamicResource Dads.Background}"
    Foreground="{DynamicResource Dads.Text}"
    FontFamily="{StaticResource UiFont}" FontSize="16" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="バージョン情報" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/PlcSim.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/PlcSim.png" Width="64" Height="64"
                           VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"><Run Text="バージョン：" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,2,0,0"><Run Text="開発元：" /><Run Text="{Binding Company, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding Copyright}" Margin="0,2,0,0" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://github.com/fa-yoshinobu/plc-sim-slmp-dotnet" RequestNavigate="OpenLink"
                                       Foreground="{DynamicResource Dads.AccentText}">
                                GitHub：fa-yoshinobu/plc-sim-slmp-dotnet
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="0,16,0,16">
                <TabItem Header="使用ライブラリ">
                    <Border Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="8">
                    <ListView ItemsSource="{Binding Libraries}" ItemContainerStyle="{StaticResource SubtleListViewItem}"
                              Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名前" Width="230" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="バージョン" Width="110" DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="ライセンス" Width="100" DisplayMemberBinding="{Binding License}" />
                                <GridViewColumn Header="用途" Width="260" DisplayMemberBinding="{Binding Purpose}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    </Border>
                </TabItem>
                <TabItem Header="アプリのライセンス">
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             Margin="0,8,0,0" Padding="12" Background="{DynamicResource Dads.Surface}" Foreground="{DynamicResource Dads.Text}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="14"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="閉じる" Style="{StaticResource PrimaryButton}" Width="100"
                    HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="CloseWindow" />
        </Grid>
    </Grid>
</ui:FluentWindow>
