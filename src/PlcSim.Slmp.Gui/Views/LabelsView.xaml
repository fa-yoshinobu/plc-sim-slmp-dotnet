<UserControl
    x:Class="PlcSim.Slmp.Gui.Views.LabelsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcSim.Slmp.Gui.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:LabelsViewModel}">
    <UserControl.Resources>
        <!-- 名前・データ型・要素数の編集列（グローバルラベルと構造体メンバで共通） -->
        <DataTemplate x:Key="NameCell" DataType="{x:Type vm:LabelRow}">
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Width="150" />
        </DataTemplate>
        <DataTemplate x:Key="TypeCell" DataType="{x:Type vm:LabelRow}">
            <ComboBox IsEditable="True" Width="180" FontFamily="{StaticResource MonoFont}"
                      ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="LengthCell" DataType="{x:Type vm:LabelRow}">
            <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Width="64" TextAlignment="Right" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource TextButton}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,6,0" Content="既定に戻す" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0,0,6,0" IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="適用" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource OutlineButton}" Command="{Binding SaveCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="設定ファイルに保存" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ラベル" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="GX Works の外部公開グローバルラベルと構造体に合わせて定義します。適用すると仮想 PLC を作り直し、名前と型が変わらないラベルの値は引き継ぎます。値はメモリビューアの「ラベル」で確認・変更できます。" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding ProfileNote}" TextWrapping="Wrap" Margin="2,0,0,12" Foreground="{DynamicResource Dads.WarningText}"
                   Visibility="{Binding ProfileNote, Converter={StaticResource NotEmptyToVisibility}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- グローバルラベル -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding AddGlobalCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="ラベルを追加" VerticalAlignment="Center" /></StackPanel></Button>
                        <StackPanel>
                            <TextBlock Text="グローバルラベル" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="SLMP で読み書きする名前。データ型は基本型か右の構造体。要素数を入れると配列（空欄は配列なし）。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ListView ItemsSource="{Binding Globals}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubtleListViewItem}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名前" Width="166" CellTemplate="{StaticResource NameCell}" />
                                <GridViewColumn Header="データ型" Width="196" CellTemplate="{StaticResource TypeCell}" />
                                <GridViewColumn Header="要素数" Width="80" CellTemplate="{StaticResource LengthCell}" />
                                <GridViewColumn Width="64">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TextButton}" Content="削除" MinHeight="32" Padding="8,0"
                                                    Command="{Binding DataContext.RemoveGlobalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 構造体 -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding AddStructCommand}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="構造体を追加" VerticalAlignment="Center" /></StackPanel></Button>
                        <StackPanel>
                            <TextBlock Text="構造体" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="メンバは上から順にメモリに並びます。" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Structs}" SelectedItem="{Binding SelectedStruct}" Width="170" DisplayMemberPath="Name" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="名前" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox Text="{Binding SelectedStruct.Name, UpdateSourceTrigger=PropertyChanged}" Width="170" FontFamily="{StaticResource MonoFont}"
                                 IsEnabled="{Binding IsStructSelected}" />
                        <Button Style="{StaticResource TextButton}" Content="削除" Command="{Binding RemoveStructCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineButton}" Command="{Binding AddMemberCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="18" Margin="0,0,6,0" /><TextBlock Text="メンバを追加" VerticalAlignment="Center" /></StackPanel></Button>
                    <ListView ItemsSource="{Binding SelectedStruct.Members}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubtleListViewItem}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="メンバ名" Width="166" CellTemplate="{StaticResource NameCell}" />
                                <GridViewColumn Header="データ型" Width="196" CellTemplate="{StaticResource TypeCell}" />
                                <GridViewColumn Header="要素数" Width="80" CellTemplate="{StaticResource LengthCell}" />
                                <GridViewColumn Width="64">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TextButton}" Content="削除" MinHeight="32" Padding="8,0"
                                                    Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="2,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Dads.TextSecondary}" />
    </Grid>
</UserControl>
