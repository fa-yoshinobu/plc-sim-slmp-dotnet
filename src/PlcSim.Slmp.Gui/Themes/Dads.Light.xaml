<!--
  デジタル庁デザインシステム（DADS）準拠のライト配色。
  値は @digital-go-jp/design-tokens 2.0.1（MIT, デジタル庁）のトークンから採用。
  コントラスト: 文字 4.5:1 以上、境界線など非テキスト 3:1 以上（DADS カラーの規定）。
  後半は WPF-UI のコントロールが参照するキーを DADS の値で上書きする。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 面 -->
    <SolidColorBrush x:Key="Dads.Background" Color="#F2F2F2" />          <!-- solid-gray-50 -->
    <SolidColorBrush x:Key="Dads.Surface" Color="#FFFFFF" />             <!-- white -->
    <SolidColorBrush x:Key="Dads.SurfaceSubtle" Color="#F2F2F2" />       <!-- solid-gray-50 -->
    <SolidColorBrush x:Key="Dads.TableHeader" Color="#E6E6E6" />         <!-- solid-gray-100 -->
    <SolidColorBrush x:Key="Dads.Border" Color="#B3B3B3" />              <!-- solid-gray-300（区切り） -->
    <SolidColorBrush x:Key="Dads.BorderStrong" Color="#666666" />        <!-- solid-gray-600（入力欄の枠） -->
    <SolidColorBrush x:Key="Dads.Divider" Color="#CCCCCC" />             <!-- solid-gray-200 -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="Dads.Text" Color="#1A1A1A" />                <!-- solid-gray-900 -->
    <SolidColorBrush x:Key="Dads.TextBody" Color="#333333" />            <!-- solid-gray-800 -->
    <SolidColorBrush x:Key="Dads.TextSecondary" Color="#4D4D4D" />       <!-- solid-gray-700（7.5:1） -->
    <SolidColorBrush x:Key="Dads.TextMuted" Color="#666666" />           <!-- solid-gray-600（5.7:1） -->
    <SolidColorBrush x:Key="Dads.TextDisabled" Color="#949494" />        <!-- solid-gray-420 -->

    <!-- キーカラー（blue） -->
    <SolidColorBrush x:Key="Dads.Accent" Color="#0017C1" />              <!-- key-900 -->
    <SolidColorBrush x:Key="Dads.AccentHover" Color="#00118F" />         <!-- key-1000 -->
    <SolidColorBrush x:Key="Dads.AccentPressed" Color="#000060" />       <!-- key-1200 -->
    <SolidColorBrush x:Key="Dads.AccentText" Color="#0017C1" />          <!-- key-900 -->
    <SolidColorBrush x:Key="Dads.AccentSubtle" Color="#E8F1FE" />        <!-- key-50 -->
    <SolidColorBrush x:Key="Dads.AccentSubtleHover" Color="#C5D7FB" />   <!-- key-200 -->
    <SolidColorBrush x:Key="Dads.AccentSubtlePressed" Color="#9DB7F9" /> <!-- key-300 -->
    <SolidColorBrush x:Key="Dads.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF" />

    <!-- セマンティック -->
    <SolidColorBrush x:Key="Dads.Success" Color="#259D63" />             <!-- success-1: green-600 -->
    <SolidColorBrush x:Key="Dads.SuccessText" Color="#197A4B" />         <!-- success-2: green-800 -->
    <SolidColorBrush x:Key="Dads.SuccessSubtle" Color="#E6F5EC" />       <!-- green-50 -->
    <SolidColorBrush x:Key="Dads.Error" Color="#EC0000" />               <!-- error-1: red-800 -->
    <SolidColorBrush x:Key="Dads.ErrorText" Color="#CE0000" />           <!-- error-2: red-900 -->
    <SolidColorBrush x:Key="Dads.ErrorSubtle" Color="#FDEEEE" />         <!-- red-50 -->
    <SolidColorBrush x:Key="Dads.Warning" Color="#B78F00" />             <!-- warning-yellow-1: yellow-700 -->
    <SolidColorBrush x:Key="Dads.WarningText" Color="#806300" />         <!-- yellow-1000 -->
    <SolidColorBrush x:Key="Dads.WarningSubtle" Color="#FBF5E0" />       <!-- yellow-50 -->
    <SolidColorBrush x:Key="Dads.Highlight" Color="#FFF0B3" />           <!-- yellow-100（直近の書込み） -->
    <SolidColorBrush x:Key="Dads.Mark" Color="#FB5B01" />                <!-- warning-orange-1: orange-600（範囲バーの書込み位置） -->

    <!-- フォーカスリング（DADS: 黒 + Yellow-300 の二重、変更不可） -->
    <SolidColorBrush x:Key="Dads.FocusOuter" Color="#000000" />
    <SolidColorBrush x:Key="Dads.FocusInner" Color="#FFD43D" />          <!-- yellow-300 -->

    <!-- 無効 -->
    <SolidColorBrush x:Key="Dads.DisabledFill" Color="#B3B3B3" />        <!-- solid-gray-300 -->
    <SolidColorBrush x:Key="Dads.OnDisabled" Color="#F2F2F2" />          <!-- solid-gray-50 -->

    <!-- WPF-UI のキーを上書き -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#949494" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0017C1" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0017C1" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E8F1FE" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#197A4B" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#E6F5EC" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#CE0000" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDEEEE" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#806300" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF0B3" />
</ResourceDictionary>
