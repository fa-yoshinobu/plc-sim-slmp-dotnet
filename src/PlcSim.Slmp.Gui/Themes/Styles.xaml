<!--
  共通スタイル。デジタル庁デザインシステム（DADS）の基本デザインに合わせる。
  ・フォント: Noto Sans JP / Noto Sans Mono（DADS 指定）。未導入環境は BIZ UD → Yu Gothic UI で代替。
  ・文字サイズ: 本文 16px（Std-16）、補足 14px（Dense-14 / Mono-14）、見出し 24〜28px Bold。14px 未満は使わない。
  ・余白: 8px 基準（8 / 16 / 24）。角丸: ボタン小 6px・中 8px、入力 8px、パネル 12px。
  ・フォーカス: 黒 4px + Yellow-300 2px の二重リング（DADS で変更不可とされている）。
  色は Themes/Dads.Light.xaml / Dads.Dark.xaml のトークン（Dads.*）を参照する。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PlcSim.Slmp.Gui.Converters">

    <FontFamily x:Key="UiFont">Noto Sans JP, BIZ UDPGothic, Yu Gothic UI, Meiryo UI</FontFamily>
    <FontFamily x:Key="MonoFont">Noto Sans Mono, BIZ UDGothic, Cascadia Mono, Consolas</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <conv:EqualsToBoolConverter x:Key="EqualsToBool" />

    <!-- フォーカスリング（黒 4px の外側に Yellow-300 2px） -->
    <Style x:Key="DadsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-6">
                        <Border BorderBrush="{DynamicResource Dads.FocusInner}" BorderThickness="2" CornerRadius="10" />
                        <Border Margin="2" BorderBrush="{DynamicResource Dads.FocusOuter}" BorderThickness="4" CornerRadius="8" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 見出し・本文（DADS テキストスタイル） -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />                 <!-- Std-28B -->
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />                 <!-- Std-16N -->
        <Setter Property="LineHeight" Value="27" />               <!-- 170% -->
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.TextSecondary}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />                 <!-- Std-18B -->
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />                 <!-- Dns-14N -->
        <Setter Property="Foreground" Value="{DynamicResource Dads.TextSecondary}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
    </Style>
    <Style x:Key="FactValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 枠（パネル）: 白い面 + gray-300 の線 + 角丸 12 -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dads.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dads.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 状態チップ -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
    </Style>

    <!-- ボタン（DADS: 塗り / アウトライン / テキスト。サイズ Small: 高さ 36・角丸 6・左右 12） -->
    <Style x:Key="DadsButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DadsFocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DadsButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Dads.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Dads.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.DisabledFill}" />
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Dads.OnDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource DadsButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Dads.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Dads.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dads.AccentText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtlePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Dads.DisabledFill}" />
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Dads.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource DadsButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Dads.AccentText}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Dads.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 切替ボタン（読出し専用・一時停止）: アウトライン、ON でキー色の薄い面 + 太枠 -->
    <Style x:Key="OutlineToggle" TargetType="ToggleButton" BasedOn="{StaticResource DadsButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Dads.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Dads.Surface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Dads.AccentText}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左ナビ: 選択はキー色の薄い面 + 左バー + キー色の太字 -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DadsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Rail" Width="4" HorizontalAlignment="Left" Margin="-16,0,0,0" CornerRadius="2"
                                    Background="{DynamicResource Dads.Accent}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Dads.AccentText}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一覧の行: 選択はキー色の薄い面 + 左バー -->
    <Style x:Key="SubtleListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DadsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Rail" Width="4" HorizontalAlignment="Left" Margin="0,4" CornerRadius="2"
                                Background="{DynamicResource Dads.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.SurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 一覧（GridView）の見出し。テーマの色に合わせる -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
        <Setter Property="Background" Value="{DynamicResource Dads.TableHeader}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Dads.Divider}" BorderThickness="0,0,1,0" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" Width="8" HorizontalAlignment="Right" Margin="0,0,-4,0" Cursor="SizeWE" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubtleListViewItem" TargetType="ListViewItem">
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Dads.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DadsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Dads.Divider}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Rail" Width="4" HorizontalAlignment="Left" Margin="0,3" CornerRadius="2"
                                Background="{DynamicResource Dads.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.SurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表示形式などの切替（セグメント）: 選択はキー色の塗り + 白文字 -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DadsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="12,4" MinHeight="32" Background="Transparent" CornerRadius="4">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Dads.AccentText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.AccentSubtle}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dads.Accent}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Dads.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Dads.AccentText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Dads.Surface}" />
    </Style>
</ResourceDictionary>
